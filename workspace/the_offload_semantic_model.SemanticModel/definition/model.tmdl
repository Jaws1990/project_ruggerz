annotation PBI_ProTooling = ["RemoteModeling","DirectLakeOnOneLakeCreatedInDesktop","DirectLakeOnOneLakeInWeb","WebModelingEdit","DevMode"]

ref table dim_competition_seasons
ref table fact_games
ref table fact_standings
ref table dim_teams
ref table dim_competitions
ref table bridge_game_team
ref table dim_game_dates
ref table dim_snapshot_dates

