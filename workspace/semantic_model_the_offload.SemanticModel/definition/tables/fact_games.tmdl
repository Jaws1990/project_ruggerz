table fact_games
	lineageTag: 51a27f3e-d70b-4f60-a896-46058b5ed536
	sourceLineageTag: [gold].[fact_games]

	/// Number of games in current filter context.
	measure 'Count of Games' = COUNTROWS(fact_games)
		formatString: #,0
		displayFolder: Freshness
		lineageTag: 40a4fe28-8354-466c-b1d1-fc9695dc4567

	/// Most recent kick-off date in current filter context — indicates how up to date the fixture/results data is.
	measure 'Latest Kick Off Date' = LASTDATE(fact_games[kick_off_date])
		formatString: General Date
		displayFolder: Freshness
		lineageTag: 436d4fa5-558c-473d-a5aa-1b9d13a6e4aa

	/// Combined home + away points across all games in context.
	measure 'Points Scored' = SUMX(fact_games, fact_games[home_score] + fact_games[away_score])
		formatString: #,0
		displayFolder: Scoring
		lineageTag: 70811742-7d71-4b14-be2d-26195b607946

	/// Average combined points scored per game — a scoring-rate indicator for comparing leagues/seasons.
	measure 'Average Points per Game' = DIVIDE([Points Scored], [Count of Games])
		formatString: #,0.0
		displayFolder: Scoring
		lineageTag: 8587ce44-231c-4018-ab28-026651e90137

	/// Average absolute points difference between winner and loser — a competitiveness indicator (lower = closer games). Reads the stored margin column directly.
	measure 'Average Winning Margin' = AVERAGEX(fact_games, fact_games[margin])
		formatString: #,0.0
		displayFolder: Scoring
		lineageTag: a04dba5d-2e50-45e3-a6c3-1edcfe74acfb

	/// Count of games won by the home team. Filters the stored `result` column directly (storage-engine scan) rather than comparing home_score/away_score row by row.
	measure 'Home Wins' = CALCULATE(COUNTROWS(fact_games), fact_games[result] = "Home Win")
		formatString: #,0
		displayFolder: Scoring
		lineageTag: 1fada04f-1e9e-40f6-b0a7-54ba5c57514c

	/// Count of games won by the away team. Filters the stored `result` column directly (storage-engine scan) rather than comparing home_score/away_score row by row.
	measure 'Away Wins' = CALCULATE(COUNTROWS(fact_games), fact_games[result] = "Away Win")
		formatString: #,0
		displayFolder: Scoring
		lineageTag: dee85e48-e343-4d3a-b48d-0e50d97a4ffb

	/// Count of drawn games. Filters the stored `result` column directly (storage-engine scan) rather than comparing home_score/away_score row by row.
	measure Draws = CALCULATE(COUNTROWS(fact_games), fact_games[result] = "Draw")
		formatString: #,0
		displayFolder: Scoring
		lineageTag: bcc65f4f-af87-47e9-9495-139f38037a97

	/// Share of games won by the home team — the headline home-advantage stat.
	measure 'Home Win %' = DIVIDE([Home Wins], [Count of Games])
		formatString: 0%
		displayFolder: Scoring
		lineageTag: 3e6b5da4-055d-4782-bbd3-2fd5f25ef013

	/// Share of games won by the away team.
	measure 'Away Win %' = DIVIDE([Away Wins], [Count of Games])
		formatString: 0%
		displayFolder: Scoring
		lineageTag: 0729727c-c601-4f8e-af14-c19d5c24bfad

	/// Share of games that ended level.
	measure 'Draw %' = DIVIDE([Draws], [Count of Games])
		formatString: 0%
		displayFolder: Scoring
		lineageTag: c13e897a-ac62-40f1-9642-1d48f67beb5d

