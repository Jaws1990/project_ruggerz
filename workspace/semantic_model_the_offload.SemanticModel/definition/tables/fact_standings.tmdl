table fact_standings
	lineageTag: 295ad5da-6707-47b9-b537-7895efbd5b4e
	sourceLineageTag: [gold].[fact_standings]

	/// Most recent standings snapshot date in current filter context — the anchor every "current" standings measure below filters to.
	measure 'Latest Snapshot Date' = LASTDATE(fact_standings[snapshot_date])
		formatString: General Date
		displayFolder: Standings - Current
		lineageTag: f6b41597-732d-4046-a537-3efd2a2a1965

	/// Team's league position as of the latest snapshot (not summed across snapshot history).
	measure 'Current Position' = ```
			VAR _SnapshotDate = [Latest Snapshot Date] 
			RETURN CALCULATE(AVERAGE(fact_standings[position]), fact_standings[snapshot_date] = _SnapshotDate)
			```
		formatString: 0
		displayFolder: Standings - Current
		lineageTag: 2c394edc-81d3-43ae-b8c2-ce6c9975f5f3

	/// Team's league points as of the latest snapshot.
	measure 'Current Points' = VAR _SnapshotDate = [Latest Snapshot Date] RETURN CALCULATE(AVERAGE(fact_standings[points]), fact_standings[snapshot_date] = _SnapshotDate)
		formatString: #,0
		displayFolder: Standings - Current
		lineageTag: 8b55a1ff-4100-411c-8237-fe84241982b0

	/// Games played to date as of the latest snapshot.
	measure 'Current Games Played' = VAR _SnapshotDate = [Latest Snapshot Date] RETURN CALCULATE(AVERAGE(fact_standings[games_played]), fact_standings[snapshot_date] = _SnapshotDate)
		formatString: #,0
		displayFolder: Standings - Current
		lineageTag: d3d29b25-f940-44b4-a035-a68a76a5095f

	/// Season win rate as of the latest snapshot.
	measure 'Current Win %' = VAR _SnapshotDate = [Latest Snapshot Date] RETURN CALCULATE(AVERAGE(fact_standings[won_percentage]), fact_standings[snapshot_date] = _SnapshotDate) * 0.01
		formatString: 0%;-0%;0%
		displayFolder: Standings - Current
		lineageTag: fe38eea2-8ce6-44e5-9b7c-c0d1ac7a1859

		changedProperty = FormatString

	/// Season draw rate as of the latest snapshot.
	measure 'Current Draw %' = ```
			
			VAR _SnapshotDate = [Latest Snapshot Date] 
			RETURN CALCULATE(AVERAGE(fact_standings[drawn_percentage]), fact_standings[snapshot_date] = _SnapshotDate) * 0.01
			```
		formatString: 0%;-0%;0%
		displayFolder: Standings - Current
		lineageTag: 57b396f3-71d5-4fe9-b79f-1c1ced977c84

		changedProperty = FormatString

	/// Season loss rate as of the latest snapshot.
	measure 'Current Loss %' = VAR _SnapshotDate = [Latest Snapshot Date] RETURN CALCULATE(AVERAGE(fact_standings[lost_percentage]), fact_standings[snapshot_date] = _SnapshotDate) * 0.01
		formatString: 0%;-0%;0%
		displayFolder: Standings - Current
		lineageTag: f2987d65-bbd8-4aa2-8f34-49755fb00621

		changedProperty = FormatString

	/// Target date exactly one week before the latest snapshot — the point Weekly movement measures compare against. Not necessarily a real snapshot date; see 'Previous Snapshot Date (Weekly)'.
	measure 'Weekly Comparison Date' = [Latest Snapshot Date] - 7
		formatString: General Date
		displayFolder: Standings - Movement
		lineageTag: 1566e70d-445e-47af-8ee4-2a847d9ad998

	/// Target date exactly one calendar month before the latest snapshot — the point Monthly movement measures compare against. Not necessarily a real snapshot date; see 'Previous Snapshot Date (Monthly)'.
	measure 'Monthly Comparison Date' = EDATE([Latest Snapshot Date], -1)
		formatString: General Date
		displayFolder: Standings - Movement
		lineageTag: 4b8be5e4-aeae-4ed9-8cca-75fddb9fda05

	/// Closest actual snapshot on or before the weekly comparison target, within the same competition/season — snapshots aren't guaranteed to land exactly 7 days apart, so an exact-date match would go blank around irregular pulls (e.g. month boundaries). Blank only if no earlier snapshot exists in the season.
	measure 'Previous Snapshot Date (Weekly)' = VAR SeasonKey = SELECTEDVALUE(fact_standings[competition_season_key]) VAR TargetDate = [Weekly Comparison Date] RETURN CALCULATE(MAX(fact_standings[snapshot_date]), fact_standings[snapshot_date] <= TargetDate, fact_standings[competition_season_key] = SeasonKey)
		formatString: General Date
		displayFolder: Standings - Movement
		lineageTag: d1f1f546-6f78-4d5a-8892-2da738eacc55

	/// Closest actual snapshot on or before the monthly comparison target, within the same competition/season — snapshots aren't guaranteed to land exactly one calendar month apart, so an exact-date match would go blank around irregular pulls. Blank only if no earlier snapshot exists in the season.
	measure 'Previous Snapshot Date (Monthly)' = VAR SeasonKey = SELECTEDVALUE(fact_standings[competition_season_key]) VAR TargetDate = [Monthly Comparison Date] RETURN CALCULATE(MAX(fact_standings[snapshot_date]), fact_standings[snapshot_date] <= TargetDate, fact_standings[competition_season_key] = SeasonKey)
		formatString: General Date
		displayFolder: Standings - Movement
		lineageTag: 2bd39583-0ae4-41c4-98b7-f261129cca50

	/// Team's league position at the closest snapshot on or before the weekly comparison target, restricted to the same competition and season. Blank if no comparable snapshot exists.
	measure 'Previous Position (Weekly)' = VAR SeasonKey = SELECTEDVALUE(fact_standings[competition_season_key]) VAR PrevSnapshotDate = [Previous Snapshot Date (Weekly)] RETURN CALCULATE(AVERAGE(fact_standings[position]), fact_standings[snapshot_date] = PrevSnapshotDate, fact_standings[competition_season_key] = SeasonKey)
		formatString: 0
		displayFolder: Standings - Movement
		lineageTag: 24716b5b-7f18-4c1d-8429-c92b49c8af25

	/// Team's league position at the closest snapshot on or before the monthly comparison target, restricted to the same competition and season. Blank if no comparable snapshot exists.
	measure 'Previous Position (Monthly)' = VAR SeasonKey = SELECTEDVALUE(fact_standings[competition_season_key]) VAR PrevSnapshotDate = [Previous Snapshot Date (Monthly)] RETURN CALCULATE(AVERAGE(fact_standings[position]), fact_standings[snapshot_date] = PrevSnapshotDate, fact_standings[competition_season_key] = SeasonKey)
		formatString: 0
		displayFolder: Standings - Movement
		lineageTag: 5e9e09d9-7d9e-49c7-a576-7536c092be3b

	/// Places risen (positive) or fallen (negative) over the last week, same competition/season only. Blank when no comparable snapshot exists.
	measure 'Position Change (Weekly)' = [Previous Position (Weekly)] - [Current Position]
		formatString: +0;-0;0
		displayFolder: Standings - Movement
		lineageTag: 41802c52-4276-49a1-a7d6-a97fccb763c7

	/// Places risen (positive) or fallen (negative) over the last month, same competition/season only. Blank when no comparable snapshot exists.
	measure 'Position Change (Monthly)' = [Previous Position (Monthly)] - [Current Position]
		formatString: +0;-0;0
		displayFolder: Standings - Movement
		lineageTag: 02ba6444-8c0b-486d-a41f-14ad5a6dbeee

	/// Average absolute rank shift across all teams in the competition/season over the last week — higher means the table is shuffling more. Teams without a week-back snapshot are excluded, not treated as zero movement.
	measure 'League Volatility (Weekly)' = AVERAGEX(FILTER(VALUES(fact_standings[team_key]), NOT ISBLANK([Position Change (Weekly)])), ABS([Position Change (Weekly)]))
		formatString: #,0.0
		displayFolder: Standings - Movement
		lineageTag: b7f98205-2b51-4178-a540-62be2459d68c

	/// Average absolute rank shift across all teams in the competition/season over the last month — higher means the table is shuffling more. Teams without a month-back snapshot are excluded, not treated as zero movement.
	measure 'League Volatility (Monthly)' = AVERAGEX(FILTER(VALUES(fact_standings[team_key]), NOT ISBLANK([Position Change (Monthly)])), ABS([Position Change (Monthly)]))
		formatString: #,0.0
		displayFolder: Standings - Movement
		lineageTag: d7bb84bb-6f51-4af2-8b07-aa6ecc3fcae1

	/// Points scored per game by a single team as of the latest snapshot — not the combined score of both sides in a fixture.
	measure 'Team Average Points per Game' = DIVIDE([Current Points For], [Current Games Played])
		formatString: #,0.0
		displayFolder: Standings - Current
		lineageTag: f47bdcef-b28b-43a7-8a8b-b62b214a95ca

	/// The team currently sitting in position 1 within a single selected competition season. Blank if the filter context spans more than one competition_season_key — position 1 in one season isn't comparable to position 1 in another.
	measure 'Leading Team' =
			
			-- get the teams in scope by using the expanded table to mimic bidirectional filter to the dimension
			VAR _teams = CALCULATETABLE(dim_teams, fact_standings)
			RETURN
			IF(HASONEVALUE(fact_standings[competition_season_key]),
			   TopEntityByMetric(_teams, [Current Position], dim_teams[team_name], TRUE)
			)
		displayFolder: Standings - Leaders
		lineageTag: b106f542-f8c0-4027-8089-4e63a64d6d82

	/// The team with the highest points-per-game average as of the latest snapshot, within the active filter context. Uses standings points, not game-level scores, to avoid resolving home/away per game.
	measure 'Team With Highest Average Points per Game' =
			
			-- get the teams in scope by using the expanded table to mimic bidirectional filter to the dimension
			VAR _teams = CALCULATETABLE(dim_teams, fact_standings)
			RETURN
			TopEntityByMetric(_teams, [Team Average Points per Game], dim_teams[team_name], FALSE())
		displayFolder: Standings - Leaders
		lineageTag: f56b3757-f08f-4b28-bdb8-60917a83abba

	measure 'Current Points For' = VAR _SnapshotDate = [Latest Snapshot Date] RETURN CALCULATE(AVERAGE(fact_standings[points_for]), fact_standings[snapshot_date] = _SnapshotDate)
		formatString: 0
		displayFolder: Standings - Current
		lineageTag: 9d18a3c7-85db-4400-a490-80a8538f6e47

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Current Points Against' = VAR _SnapshotDate = [Latest Snapshot Date] RETURN CALCULATE(AVERAGE(fact_standings[points_against]), fact_standings[snapshot_date] = _SnapshotDate)
		formatString: 0
		displayFolder: Standings - Current
		lineageTag: 1051e3df-7bcc-418d-9f10-2693dda5aa34

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Team Form SVG' = ```
			
			VAR _SnapshotDate = [Latest Snapshot Date]
			VAR _Form =
			    CALCULATE(
			        SELECTEDVALUE( fact_standings[form] ),
			        fact_standings[snapshot_date] = _SnapshotDate
			    )
			VAR _F = RIGHT( _Form, 5 )
			VAR _Len = LEN( _F )
			VAR _C1 = MID( _F, 1, 1 )
			VAR _C2 = MID( _F, 2, 1 )
			VAR _C3 = MID( _F, 3, 1 )
			VAR _C4 = MID( _F, 4, 1 )
			VAR _C5 = MID( _F, 5, 1 )
			VAR _RectAttrs = """ y=""0"" width=""17"" height=""17"" rx=""3"" ry=""3"" fill="""
			VAR _TextAttrs = """ y=""12"" text-anchor=""middle"" font-family=""Segoe UI, system-ui, sans-serif"" font-size=""9"" font-weight=""700"" fill="""
			VAR _B1 =
			    IF( _C1 = "", "",
			        "<rect x=""0" & _RectAttrs & SWITCH( _C1, "W", "rgb(95,184,138)", "L", "rgb(214,69,65)", "rgb(158,158,158)" ) & """/>"
			            & "<text x=""8.5" & _TextAttrs & IF( _C1 = "W", "rgb(13,31,22)", "rgb(255,255,255)" ) & """>" & _C1 & "</text>"
			    )
			VAR _B2 =
			    IF( _C2 = "", "",
			        "<rect x=""19" & _RectAttrs & SWITCH( _C2, "W", "rgb(95,184,138)", "L", "rgb(214,69,65)", "rgb(158,158,158)" ) & """/>"
			            & "<text x=""27.5" & _TextAttrs & IF( _C2 = "W", "rgb(13,31,22)", "rgb(255,255,255)" ) & """>" & _C2 & "</text>"
			    )
			VAR _B3 =
			    IF( _C3 = "", "",
			        "<rect x=""38" & _RectAttrs & SWITCH( _C3, "W", "rgb(95,184,138)", "L", "rgb(214,69,65)", "rgb(158,158,158)" ) & """/>"
			            & "<text x=""46.5" & _TextAttrs & IF( _C3 = "W", "rgb(13,31,22)", "rgb(255,255,255)" ) & """>" & _C3 & "</text>"
			    )
			VAR _B4 =
			    IF( _C4 = "", "",
			        "<rect x=""57" & _RectAttrs & SWITCH( _C4, "W", "rgb(95,184,138)", "L", "rgb(214,69,65)", "rgb(158,158,158)" ) & """/>"
			            & "<text x=""65.5" & _TextAttrs & IF( _C4 = "W", "rgb(13,31,22)", "rgb(255,255,255)" ) & """>" & _C4 & "</text>"
			    )
			VAR _B5 =
			    IF( _C5 = "", "",
			        "<rect x=""76" & _RectAttrs & SWITCH( _C5, "W", "rgb(95,184,138)", "L", "rgb(214,69,65)", "rgb(158,158,158)" ) & """/>"
			            & "<text x=""84.5" & _TextAttrs & IF( _C5 = "W", "rgb(13,31,22)", "rgb(255,255,255)" ) & """>" & _C5 & "</text>"
			    )
			VAR _W = _Len * 19 - 2
			VAR _SVG =
			    "<svg xmlns=""http://www.w3.org/2000/svg"" width=""" & _W & """ height=""17"" viewBox=""0 0 " & _W & " 17"">"
			        & _B1 & _B2 & _B3 & _B4 & _B5
			        & "</svg>"
			RETURN
			    IF( _Len = 0, BLANK(), "data:image/svg+xml;utf8," & _SVG )
			
			```
		displayFolder: Standings - Current
		lineageTag: 85a5cfc8-6731-4525-aadd-6cb8b5b56a00
		dataCategory: ImageUrl

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = DataCategory

